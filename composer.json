{
    "name": "tyhpdef/symfony-security-http-impl",
    "description": "Implementation package for tyhpdef/symfony-security-http. Require tyhpdef/symfony-security-http, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.4.19.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/symfony-http-foundation": "@dev",
                "tyhpdef/symfony-event-dispatcher": "@dev",
                "tyhpdef/symfony-http-kernel": "@dev",
                "tyhpdef/symfony-security-core": "@dev",
                "tyhpdef/symfony-property-access": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev",
                "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
                "tyhpdef/symfony-cache-contracts": "@dev",
                "tyhpdef/symfony-console": "@dev",
                "tyhpdef/symfony-string": "@dev",
                "tyhpdef/symfony-translation-contracts": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/psr-container": "@dev",
                "tyhpdef/symfony-password-hasher": "@dev",
                "tyhpdef/symfony-security-csrf": "@dev",
                "tyhpdef/symfony-expression-language": "@dev",
                "tyhpdef/symfony-cache": "@dev",
                "tyhpdef/psr-cache": "@dev",
                "tyhpdef/symfony-var-exporter": "@dev",
                "tyhpdef/psr-clock": "@dev",
                "tyhpdef/psr-simple-cache": "@dev",
                "tyhpdef/php-ext-memcached": "@dev",
                "tyhpdef/php-ext-redis": "@dev",
                "tyhpdef/predis-predis": "@dev",
                "tyhpdef/php-ext-pdo": "@dev",
                "tyhpdef/psr-event-dispatcher": "@dev",
                "tyhpdef/symfony-notifier": "@dev",
                "tyhpdef/symfony-mailer": "@dev",
                "tyhpdef/symfony-mime": "@dev",
                "tyhpdef/egulias-email-validator": "@dev",
                "tyhpdef/symfony-http-client-contracts": "@dev",
                "tyhpdef/doctrine-lexer": "@dev",
                "tyhpdef/php-ext-session": "@dev",
                "tyhpdef/symfony-error-handler": "@dev",
                "tyhpdef/symfony-var-dumper": "@dev",
                "tyhpdef/symfony-property-info": "@dev",
                "tyhpdef/symfony-type-info": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/symfony-security-http"
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/security-http": "7.4.19"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-http-foundation": "@dev",
        "tyhpdef/symfony-event-dispatcher": "@dev",
